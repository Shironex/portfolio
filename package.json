{
  "name": "portfolio",
  "version": "2.13.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:email": "email dev -p 3001 --dir ./src/lib/mail/templates",
    "build": "next build --turbopack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "format": "prettier 'src/**/*.{js,ts,jsx,tsx}' --write",
    "format:check": "prettier 'src/**/*.{js,ts,jsx,tsx}' --check",
    "release": "standard-version",
    "debug-release": "node scripts/debug-release.js",
    "generate:icons": "node scripts/generate-icons.mjs",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.9.0"
  },
  "packageManager": "pnpm@10.9.0",
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "6.0.0",
    "jiti": "^2.7.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-safe-action": "^8.7.3",
    "posthog-js": "^1.430.2",
    "posthog-node": "^5.52.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-turnstile": "^1.1.5",
    "resend": "^6.28.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.3.5",
    "@next/eslint-plugin-next": "^16.3.5",
    "@noctcore/eslint-plugin-async-safety": "^0.3.2",
    "@noctcore/eslint-plugin-code-quality": "^0.2.2",
    "@noctcore/eslint-plugin-contracts": "^0.6.1",
    "@noctcore/eslint-plugin-react": "^0.4.0",
    "@noctcore/eslint-plugin-security": "^0.3.0",
    "@playwright/test": "^1.63.0",
    "@react-email/ui": "6.9.5",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-n": "^18.3.0",
    "husky": "^9.1.7",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "6.9.5",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.4",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
